#!/usr/bin/env bash
# Pre-push hook — run the leak scan, then dashboard verify (lint + typecheck +
# tests), before pushing.
#
# DEVHUB_SKIP_VERIFY=1     bypass everything, leak scan included (emergencies).
# DEVHUB_PREPUSH=content   set by the app's content sync only. Skips the ~2 min
#                          verify when every commit being pushed touches only
#                          content folders; the leak scan still runs either way.
#                          Any other file in the push runs the full verify.
set -e

if [[ "${DEVHUB_SKIP_VERIFY:-0}" == "1" ]]; then
    echo "[pre-push] DEVHUB_SKIP_VERIFY=1 — skipping checks."
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
DASHBOARD_DIR="$REPO_ROOT/dashboard"

# Keep in step with CONTENT_SYNC_PATHS in dashboard/lib/content/sync-paths.ts
# (a unit test fails if they drift).
CONTENT_PATHS=(notes collections tasks docs diagrams upstarts)

is_content_path() {
    local file="$1" folder
    # Timers stay on the machine that made them; never treat them as syncable content.
    case "$file" in
        tasks/.local | tasks/.local/* | tasks/*/.local | tasks/*/.local/*) return 1 ;;
    esac
    for folder in "${CONTENT_PATHS[@]}"; do
        [[ "$file" == "$folder" || "$file" == "$folder/"* ]] && return 0
    done
    return 1
}

# stdin is git's "<local ref> <local sha> <remote ref> <remote sha>" lines.
# Prints why the push is NOT content-only (a file, or a failure to tell), and
# nothing when every commit touches only content paths. Fails closed: if we
# can't list the commits, the full verify runs.
non_content_reason() {
    local remote="$1" local_ref local_sha remote_ref remote_sha commits commit file
    while read -r local_ref local_sha remote_ref remote_sha; do
        [[ -n "$local_sha" ]] || continue
        [[ "$local_sha" =~ ^0+$ ]] && continue # deleting a ref pushes no commits
        if [[ "$remote_sha" =~ ^0+$ ]]; then
            # New remote ref: everything the remote doesn't already have.
            commits="$(git rev-list "$local_sha" --not --remotes="$remote" 2>/dev/null)" \
                || { echo "could not list the new commits on $local_ref"; return; }
        else
            commits="$(git rev-list "$remote_sha..$local_sha" 2>/dev/null)" \
                || { echo "could not list the commits on $local_ref"; return; }
        fi
        for commit in $commits; do
            # -m so a merge is judged against each parent; --no-renames so a move
            # out of a content folder lists both paths.
            while IFS= read -r file; do
                [[ -n "$file" ]] || continue
                if ! is_content_path "$file"; then
                    echo "${commit:0:9} touches $file"
                    return
                fi
            done < <(git diff-tree --no-commit-id --name-only -r -m --no-renames --root "$commit" 2>/dev/null)
        done
    done <<< "$2"
}

CONTENT_ONLY=0
if [[ "${DEVHUB_PREPUSH:-}" == "content" ]]; then
    NON_CONTENT="$(non_content_reason "${1:-}" "$(cat)")"
    if [[ -z "$NON_CONTENT" ]]; then
        CONTENT_ONLY=1
    else
        echo "[pre-push] DEVHUB_PREPUSH=content, but $NON_CONTENT — running the full verify."
    fi
fi

# Verify needs the repo's pinned Node (.nvmrc) — pushes from shells without nvm
# loaded (IDEs, GUI clients, plain terminals) would otherwise run vitest under
# an older system Node and false-fail. Source nvm here when node doesn't match.
if [[ "$CONTENT_ONLY" != "1" && -f "$REPO_ROOT/.nvmrc" ]]; then
    WANT_NODE="$(tr -d '[:space:]' < "$REPO_ROOT/.nvmrc")"
    HAVE_NODE="$(node --version 2>/dev/null || true)"
    case "${HAVE_NODE#v}" in
        "$WANT_NODE" | "$WANT_NODE".*) : ;; # already on the pinned major
        *)
            export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
            if [[ -s "$NVM_DIR/nvm.sh" ]]; then
                # shellcheck disable=SC1091
                . "$NVM_DIR/nvm.sh" --no-use
                nvm use --silent "$WANT_NODE" >/dev/null 2>&1 || true
            fi
            HAVE_NODE="$(node --version 2>/dev/null || echo none)"
            case "${HAVE_NODE#v}" in
                "$WANT_NODE" | "$WANT_NODE".*)
                    echo "[pre-push] Using Node $HAVE_NODE via nvm (.nvmrc: $WANT_NODE)." ;;
                *)
                    echo "[pre-push] WARNING: Node $HAVE_NODE does not match .nvmrc ($WANT_NODE) and nvm couldn't switch — verify may fail. Run 'nvm install $WANT_NODE'." ;;
            esac
            ;;
    esac
fi

echo "[pre-push] Scanning for internal-name / secret leaks…"
if ! bash "$REPO_ROOT/scripts/scan-leaks.sh" tree; then
    echo "[pre-push] Leak scan failed. Fix the hits above or set DEVHUB_SKIP_VERIFY=1 to override."
    exit 1
fi

# Content-only push from the app: the leak scan above is the check that matters
# for notes and tasks, and verify covers code that isn't in this push.
if [[ "$CONTENT_ONLY" == "1" ]]; then
    echo "[pre-push] DEVHUB_PREPUSH=content and every pushed commit is content-only — skipping verify (leak scan passed)."
    exit 0
fi

if [[ ! -d "$DASHBOARD_DIR/node_modules" ]]; then
    echo "[pre-push] node_modules missing — skipping verify."
    echo "[pre-push] Run 'npm install' at the repo root (or 'cd dashboard && npm install') to enable pre-push checks."
    exit 0
fi

# Desktop sidecar / polluted IDE shells leave NODE_ENV=production, PORT, and
# DEVHUB_* layout vars. That makes `next build` fail with opaque
# `TypeError: generate is not a function`. Mirror scrubDesktopRuntimeEnv here so
# pushes from Cursor/IDE terminals get the same hygiene as DevHub's git API.
if [[ "${NODE_ENV:-}" == "production" ]]; then
    unset NODE_ENV
fi
unset PORT
while IFS= read -r key; do
    case "$key" in
        DEVHUB_OP_*|DEVHUB_REPOS_DIR|DEVHUB_ALLOWED_DEV_ORIGINS) ;;
        DEVHUB_*) unset "$key" ;;
    esac
done < <(env | awk -F= '/^DEVHUB_/ { print $1 }')
unset NOTES_DIR TASKS_DIR COLLECTIONS_DIR UPSTARTS_DIR DOCS_DIR
# Git hands hooks GIT_DIR (absolute when pushing from a linked worktree) and passes
# through GIT_CONFIG_* overrides. Tests that build throwaway repos inherit them and
# commit, branch, write config or run hooks against this repo, so verify sees none.
while IFS= read -r key; do
    unset "$key"
done < <(env | awk -F= '/^GIT_/ { print $1 }')
# Packaged Next standalone puts a JSON config (no functions) on process.env;
# if that leaks into this hook, `next build` dies with generate is not a function.
while IFS= read -r key; do
    unset "$key"
done < <(env | awk -F= '/^__NEXT_PRIVATE_/ { print $1 }')

echo "[pre-push] Running dashboard verify…"
cd "$DASHBOARD_DIR"
if ! npm run --silent verify; then
    echo ""
    echo "[pre-push] Verify failed. Fix the errors above or set DEVHUB_SKIP_VERIFY=1 to override."
    exit 1
fi

# Backport drift — a warning, never a blocker. The mirror silently running
# ahead of public core is how backports get conflict-prone; being told at push
# time is the cheapest possible reminder.
if [[ -x "$REPO_ROOT/scripts/devhub-backport-status.sh" ]]; then
    if ! bash "$REPO_ROOT/scripts/devhub-backport-status.sh" >/dev/null 2>&1; then
        echo ""
        bash "$REPO_ROOT/scripts/devhub-backport-status.sh" 2>/dev/null || true
        echo ""
        echo "[pre-push] ^ backport reminder only — your push is going ahead."
    fi
fi

echo "[pre-push] All checks passed."
