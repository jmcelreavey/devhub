# Python
*.pyc
__pycache__/
*.pyo
*.egg-info/
dist/
build/
.venv/
venv/
.env
.env.*
!.env.example

# Node
node_modules/
# The Linux container build swaps the host's modules aside under this name.
# `node_modules/` does not match it, and a `git add -A` while a build was in
# flight staged 43,000 files including a 116 MB native binary — which GitHub
# rejected outright. Ignoring it is cheaper than remembering not to.
node_modules.host/
*.lock

# Next.js dashboard build artifacts. DEVHUB_DIST_DIR (next.config.ts) lets any
# instance pick its own dist dir, so match the prefix rather than chasing names.
apps/ui/.next*/
apps/ui/.env.local
apps/ui/output/

# Pre-restructure residue: the old root-level dashboard workspace and the
# installer staging tree are build output only. Unignored, they get swept into
# the pre-push lint and poison every push from the checkout.
/dashboard/
/desktop/

# Trace artifacts at repo root
/.next/

# Database client state. In a checkout the app-data dir *is* the repo root, so
# these land here. `db-connections.json` can hold a database password, which
# must never be committed — not even to this private mirror, which is the one
# place personal data is otherwise expected.
/db-connections.json
/db-history.json

# Local automation artifacts
.agent-screenshots/

# Per-machine auto-review registry. The poller rewrites it constantly; tracking it
# turned every review start into a content-sync commit.
notes/.config/auto-pr-reviews.json

# Claude Code worktrees and session artefacts
.claude/
.claire/
debug-*.sh

# Electron launcher removed; ignore local leftovers
electron-wrapper/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Database - WAL and temp files (prevents SQLite lock corruption)
*.db-shm
*.db-wal
*.sqlite-shm
*.sqlite-wal
*.sqlite3-shm
*.sqlite3-wal

# Logs
*.log
logs/
# Next.js routes that happen to be named logs/ — not log directories.
!apps/ui/app/logs/
!apps/ui/app/logs/**
!apps/ui/app/api/status/logs/
!apps/ui/app/api/status/logs/**

# OS-level
.Spotlight-V100
.Trashes

# Local diagram scratch files (manual testing only)
notes/diagrams/theme-demo.json
notes/diagrams/test.json

# Morning briefing AI cache (generated, machine-local)
notes/.cache/

# DevHub local app state (machine-local)
.devhub/
# QA receipts can contain screenshots and application content; export evidence explicitly.
notes/.config/qa/

# Agent-run transcripts and idempotency keys. One directory per dispatch.
# The task-agent-runs index is the durable record.
notes/.config/agent-runs/.requests/
notes/.config/agent-runs/run-*/

# Ad-hoc review screenshots
/.review-shots/

# Local tool artifacts
.openchamber/
.pr-review-tmp/
.tmp-pr*/
# QA walk recordings (local only)
.tmp-qa-videos/

# Task timers are per machine. The task items themselves stay synced.
tasks/.local/
tasks/*/.local/

# Agent run result scratch files
/*.result
