# Python
*.pyc
__pycache__/
*.pyo
*.egg-info/
dist/
build/
.venv/
venv/
.env
.env.*
!.env.example

# Node
node_modules/
# The Linux container build swaps the host's modules aside under this name.
# `node_modules/` does not match it, and a `git add -A` while a build was in
# flight staged 43,000 files including a 116 MB native binary — which GitHub
# rejected outright. Ignoring it is cheaper than remembering not to.
node_modules.host/
*.lock
/package-lock.json

# Next.js dashboard build artifacts
dashboard/.next/
dashboard/.next-verify/
dashboard/.env.local
dashboard/output/

# Trace artifacts at repo root
/.next/

# Local automation artifacts
.agent-screenshots/

# Claude Code worktrees and session artefacts
.claude/
.claire/
debug-*.sh

# Electron launcher removed; ignore local leftovers
electron-wrapper/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Database - WAL and temp files (prevents SQLite lock corruption)
*.db-shm
*.db-wal
*.sqlite-shm
*.sqlite-wal
*.sqlite3-shm
*.sqlite3-wal

# Logs
*.log
logs/
# Next.js routes that happen to be named logs/ — not log directories.
!dashboard/app/logs/
!dashboard/app/logs/**
!dashboard/app/api/status/logs/
!dashboard/app/api/status/logs/**

# OS-level
.Spotlight-V100
.Trashes

# Local diagram scratch files (manual testing only)
notes/diagrams/theme-demo.json
notes/diagrams/test.json

# Morning briefing AI cache (generated, machine-local)
notes/.cache/

# DevHub local app state (machine-local)
.devhub/

# Ad-hoc review screenshots
/.review-shots/
