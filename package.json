{
  "name": "devhub",
  "private": true,
  "engines": {
    "node": ">=20.12"
  },
  "description": "Run npm install and npm run dev from the repo root; delegates to dashboard/.",
  "scripts": {
    "install": "npm install --prefix ./dashboard && rm -f package-lock.json",
    "desktop:stage": "node desktop/scripts/stage-all.mjs",
    "desktop:dev": "node desktop/scripts/stage-all.mjs && cargo tauri dev --config desktop/src-tauri/tauri.conf.json",
    "desktop:build": "node desktop/scripts/stage-all.mjs && cargo tauri build --config desktop/src-tauri/tauri.conf.json --config '{\"bundle\":{\"createUpdaterArtifacts\":false}}' && node desktop/scripts/sign-local.mjs",
    "desktop:doctor": "node desktop/scripts/doctor.mjs",
    "desktop:test": "node --test \"desktop/**/*.test.mjs\"",
    "desktop:selftest": "node desktop/scripts/selftest.mjs",
    "dev": "npm run dev --prefix ./dashboard",
    "start": "npm run start --prefix ./dashboard",
    "build": "npm run build --prefix ./dashboard",
    "verify": "npm run verify --prefix ./dashboard",
    "lint": "npm run lint --prefix ./dashboard",
    "typecheck": "npm run typecheck --prefix ./dashboard",
    "test": "npm run test --prefix ./dashboard",
    "doctor": "npm run doctor --prefix ./dashboard",
    "setup": "npm run setup --prefix ./dashboard",
    "clean": "npm run clean --prefix ./dashboard",
    "restart": "npm run restart --prefix ./dashboard",
    "desktop:sign": "node desktop/scripts/sign-local.mjs",
    "desktop:verify": "node desktop/scripts/verify-staging.mjs",
    "desktop:install": "node desktop/scripts/install-local.mjs"
  }
}
