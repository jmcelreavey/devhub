{
  "name": "dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.14",
    "npm": ">=10 <12"
  },
  "scripts": {
    "preinstall": "node scripts/check-npm.mjs && node scripts/check-plugin-requirements.mjs",
    "dev": "node ../../scripts/dev.mjs",
    "predev": "node ../../scripts/gen-core-routes.mjs && node ../../scripts/build-editor-extension.mjs && tsx ../core/src/scripts/health-check.ts",
    "prebuild": "node ../../scripts/gen-core-routes.mjs",
    "build": "vite build",
    "start": "node ../../scripts/dev.mjs --production",
    "doctor": "tsx ../core/src/scripts/doctor.ts",
    "check:contrast": "node scripts/contrast-check.mjs",
    "skills:verify-vendor": "tsx ../core/src/scripts/verify-vendor-skills.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "eslint --max-warnings 0 --cache --cache-location .eslintcache",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:all -- --config vitest.fast.config.ts",
    "test:e2e:skills": "node scripts/e2e-skills-catalog.mjs",
    "test:e2e:skills:ux": "node scripts/e2e-skills-ux-walkthrough.mjs",
    "test:watch": "env -u DEVHUB_DESKTOP -u DEVHUB_APP_DATA -u DEVHUB_RESOURCE_ROOT -u DEVHUB_SERVER_DIR -u NOTES_DIR -u TASKS_DIR -u COLLECTIONS_DIR -u UPSTARTS_DIR -u DOCS_DIR -u DEVHUB_OP_CACHE_DIR -u DEVHUB_OP_CACHE -u DEVHUB_OP_REFRESH -u DEVHUB_OP_SYNC_LOCAL -u DEVHUB_OP_ITEM -u DEVHUB_OP_VAULT -u JIRA_API_TOKEN -u GOOGLE_CLIENT_SECRET NODE_ENV=test vitest",
    "build:seasonal-icons": "tsx scripts/build-seasonal-iconify-subset.ts",
    "icons:pwa": "node ../core/src/scripts/render-brand-icons.mjs",
    "verify": "npm run test",
    "postinstall": "tsx ../core/src/scripts/postinstall.ts",
    "setup": "tsx scripts/setup-reminder.ts",
    "plugins": "tsx ../core/src/scripts/plugins.ts",
    "docs:diagrams": "tsx ../core/src/scripts/check-docs-diagrams.mts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify:checks": "npm run test",
    "verify:build": "npm run build:slim",
    "test:all": "env -u DEVHUB_CONFIG_DIR -u DEVHUB_TASK_MIGRATION_DIR -u XDG_DATA_HOME -u DEVHUB_PLUGIN_HOME -u DEVHUB_PLUGIN_TARGET_HOME -u DEVHUB_DESKTOP -u DEVHUB_APP_DATA -u DEVHUB_RESOURCE_ROOT -u DEVHUB_SERVER_DIR -u NOTES_DIR -u TASKS_DIR -u COLLECTIONS_DIR -u UPSTARTS_DIR -u DOCS_DIR -u DEVHUB_OP_CACHE_DIR -u DEVHUB_OP_CACHE -u DEVHUB_OP_REFRESH -u DEVHUB_OP_SYNC_LOCAL -u DEVHUB_OP_ITEM -u DEVHUB_OP_VAULT -u JIRA_API_TOKEN -u GOOGLE_CLIENT_SECRET NODE_ENV=test NODE_OPTIONS='--no-deprecation --disable-warning=ExperimentalWarning' vitest run",
    "prebuild:slim": "node ../../scripts/gen-core-routes.mjs",
    "build:slim": "vite build"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.104",
    "@ai-sdk/openai-compatible": "^2.0.47",
    "@ai-sdk/provider": "^3.0.0",
    "@ai-sdk/react": "^3.0.195",
    "@blocknote/core": "^0.50.0",
    "@blocknote/mantine": "^0.50.0",
    "@blocknote/react": "^0.50.0",
    "@blocknote/xl-ai": "^0.50.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@devhub/core": "file:../core",
    "@devhub/qa": "0.1.5",
    "@devhub/shared-actions": "file:../../packages/shared",
    "@getpaseo/client": "0.10.1",
    "@iconify/react": "^6.0.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@slack/socket-mode": "^3.1.0",
    "@slack/web-api": "^8.2.0",
    "@wterm/core": "0.5.7",
    "@wterm/dom": "0.5.7",
    "@wterm/ghostty": "0.5.7",
    "@wterm/react": "0.5.7",
    "adm-zip": "0.6.0",
    "ai": "^6.0.190",
    "aws4": "^1.13.2",
    "cron-parser": "^5.5.0",
    "googleapis": "^171.4.0",
    "lucide-react": "^1.14.0",
    "mermaid": "^11.15.0",
    "mongodb": "^6.21.0",
    "node-pty": "^1.2.0-beta.12",
    "pg": "^8.21.0",
    "playwright-core": "1.60.0",
    "prosemirror-model": "^1.25.0",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.41.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "^7.6.2",
    "refractor": "^5.0.0",
    "swr": "^2.4.1",
    "tldraw": "^5.0.1",
    "ws": "^8.21.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@iconify-json/fluent-emoji-flat": "^1.2.5",
    "@iconify/types": "^2.0.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/hast": "^3.0.4",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.5",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "jsdom": "^29.1.1",
    "playwright": "^1.58.2",
    "postcss": "^8.5.0",
    "sharp": "^0.34.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vite": "^6.4.1",
    "vitest": "^4.1.5",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "eslint-plugin-react-hooks": "^7.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
