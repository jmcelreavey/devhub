{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Minimal surface for the local boot page. The dashboard's remote loopback origins receive their own explicitly scoped capability below.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:event:allow-listen",
    "dialog:allow-open",
    "opener:default",
    "updater:default"
  ],
  "remote": {
    "urls": [
      "http://localhost:1337/*",
      "http://127.0.0.1:1337/*"
    ]
  }
}
