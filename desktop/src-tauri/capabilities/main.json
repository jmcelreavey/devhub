{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "What both the local boot page and the dashboard's loopback origins may call — every app command here is one lib/desktop/bridge.ts or UpdateBanner uses. Boot-page-only commands live in boot.json, which has no remote block.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:event:allow-listen",
    "dialog:allow-open",
    "notification:default",
    "opener:default",
    "updater:default",
    "allow-desktop-info",
    "allow-pick-folder",
    "allow-open-logs",
    "allow-renderer-log",
    "allow-set-desktop-icon",
    "allow-current-version",
    "allow-check-update",
    "allow-install-update",
    "allow-relaunch",
    "allow-wake-helper-install",
    "allow-wake-helper-uninstall",
    "allow-login-item-status",
    "allow-login-item-set"
  ],
  "remote": {
    "urls": [
      "http://localhost:1337/*",
      "http://127.0.0.1:1337/*"
    ]
  }
}
